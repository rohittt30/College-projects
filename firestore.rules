rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private record for each student: name, email-linked data, progress and settings.
    // Only the owner can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard entry. Holds only the username, coins and avatar color.
    // Private accounts have no entry. The username must be one the student has claimed.
    match /board/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'points', 'av', 'updated'])
        && request.resource.data.username is string
        && request.resource.data.points is number
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Username claims. The document id is the username, so ids are unique.
    // Anyone can check one name (needed on the sign-up form), but nobody can list them all.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 't']);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
